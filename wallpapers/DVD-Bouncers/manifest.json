{
  "name": "DVD-Bouncers",
  "description": "Плавающие фигуры в палитре системы с анимацией тапов и блокировки экрана",
  "author": "Artho",
  "version": "1.0.0",
  "minAppVersion": ">=1.0.0",
  "cover": "cover.jpg",
  "icon": "icon.png",
  "main": "index.html",
  "settingsPath": "settings/index.html",
  "useGyroscope": false,
  "isLite": false,
  "animationDuration": 3.0,
  "animationDurationUnlock": 2.5,
  "animationDurationScreenOn": 1.2,
  "animationDurationScreenOff": 0.4,
  "animateOn": "both",
  "themeSupport": ["light", "dark"],
  "supportsMonet": true,
  "tags": ["material", "dynamic", "figures"],
  "defaultSettings": {
    "useMaterialYou": false,
    "changeOnTap": true,
    "enableCollisions": true,
    "lockAnim":true,
    "shapeCount": 6,
    "shapeSize": 90
  }
}
